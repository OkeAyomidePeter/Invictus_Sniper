# ============================================
# INVICTUS SNIPER BOT - ENVIRONMENT VARIABLES
# ============================================

# ----------------
# Core Configuration
# ----------------
HELIUS_API_KEY=99943024-11c0-4ca5-b2f2-4db27bae9e93
SOLANA_PRIVATE_KEY=~/.config/solana/devnet.json

# ----------------
# Telegram Bot
# ----------------
TELEGRAM_BOT_TOKEN=8089305729:AAEFqEG2XP_MeTOWUOIdOJ2kBWdraHvYe6o
TELEGRAM_CHAT_ID=6233841137

# ----------------
# Database
# ----------------
DATABASE_URL=sqlite://invictus.db

# ----------------
# Risk Parameters
# ----------------
MIN_LIQUIDITY_SOL=10.0
MIN_HOLDERS=10
MAX_TRADE_SIZE_SOL=1.0
MAX_DAILY_EXPOSURE_SOL=10.0
MAX_CREATOR_OWNERSHIP_PERCENTAGE=50.0
HONEYPOT_CHECK_ENABLED=true
JUPITER_API_TIMEOUT_MS=5000

# ----------------
# Auto-Sell Configuration
# ----------------
AUTO_SELL_ENABLED=true
AUTO_SELL_PROFIT_TARGET_PCT=50.0        # Profit target: +50%
AUTO_SELL_STOP_LOSS_PCT=20.0            # Stop-loss: -20%
AUTO_SELL_TIMEOUT_SECONDS=120           # Timeout after 120 seconds
AUTO_SELL_SLIPPAGE_BPS=300              # 3% slippage for sells
AUTO_SELL_PRICE_CHECK_INTERVAL_MS=2000  # Check price every 2 seconds

# ----------------
# Dynamic Jito Tips
# ----------------
JITO_DYNAMIC_TIPS_ENABLED=true
JITO_BASE_TIP_LAMPORTS=1000000          # 0.001 SOL base tip
JITO_MIN_TIP_LAMPORTS=500000            # 0.0005 SOL minimum
JITO_MAX_TIP_LAMPORTS=5000000           # 0.005 SOL maximum

# ----------------
# Retry Logic
# ----------------
TX_RETRY_MAX_ATTEMPTS=3                 # Retry failed transactions up to 3 times
TX_RETRY_INITIAL_DELAY_MS=500           # Start with 500ms delay
TX_RETRY_MAX_DELAY_MS=5000              # Cap delay at 5 seconds
TX_RETRY_BACKOFF_MULTIPLIER=2.0         # Exponential backoff (2x each retry)

# ----------------
# Rate Limiting
# ----------------
RATE_LIMITING_ENABLED=true
HELIUS_MAX_REQUESTS_PER_SECOND=10.0     # Helius RPC rate limit
JUPITER_MAX_REQUESTS_PER_SECOND=5.0     # Jupiter API rate limit

# ----------------
# Wallet Monitoring
# ----------------
WALLET_LOW_BALANCE_ALERT_SOL=0.5        # Alert when balance drops below 0.5 SOL
WALLET_MONITOR_INTERVAL_SECS=60         # Check balance every 60 seconds
WALLET_RESERVE_FOR_FEES_SOL=0.1         # Reserve 0.1 SOL for transaction fees

# ----------------
# Parallel Trading
# ----------------
MAX_CONCURRENT_TRADES=5                 # Maximum simultaneous trades
MAX_OPEN_POSITIONS=10                   # Maximum total open positions
TOTAL_EXPOSURE_LIMIT_SOL=10.0           # Maximum SOL at risk across all positions
