# API Keys (Required)
HELIUS_API_KEY=your_helius_api_key
BIRDEYE_API_KEY=your_birdeye_api_key
JUPITER_API_KEY=your_jupiter_api_key
MORALIS_API_KEY=your_moralis_api_key

# Wallet & Security (Required)
SOLANA_PRIVATE_KEY=your_base58_private_key_or_path_to_json_file
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# ALTERNATE_TELEGRAM_CHAT_ID=optional_alternate_chat_id

# Network & Database
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DATABASE_URL=sqlite://invictus.db

# Trading Safety
MIN_LIQUIDITY_USD=2500.0
MIN_HOLDERS=10
MAX_TRADE_SIZE_SOL=1.0
MAX_DAILY_EXPOSURE_SOL=10.0
MAX_CREATOR_OWNERSHIP_PERCENTAGE=50.0
HONEYPOT_CHECK_ENABLED=true
JUPITER_API_TIMEOUT_MS=5000

# Transaction Configuration
# Options: Standard, Jito
TRANSACTION_MODE=Standard
PRIORITY_FEE_LAMPORTS=10000
COMPUTE_UNIT_LIMIT=200000

# Auto-Sell Configuration
AUTO_SELL_ENABLED=true
AUTO_SELL_PROFIT_TARGET_PCT=50.0
AUTO_SELL_STOP_LOSS_PCT=20.0
AUTO_SELL_TIMEOUT_SECONDS=120
AUTO_SELL_SLIPPAGE_BPS=300
AUTO_SELL_PRICE_CHECK_INTERVAL_MS=5000

# Jito Configuration (Only for Jito mode)
JITO_BASE_TIP_LAMPORTS=1000000
JITO_MIN_TIP_LAMPORTS=500000
JITO_MAX_TIP_LAMPORTS=5000000
JITO_DYNAMIC_TIPS_ENABLED=true

# Retry Strategy
TX_RETRY_MAX_ATTEMPTS=3
TX_RETRY_INITIAL_DELAY_MS=500
TX_RETRY_MAX_DELAY_MS=5000
TX_RETRY_BACKOFF_MULTIPLIER=2.0

# Rate Limiting
HELIUS_MAX_REQUESTS_PER_SECOND=10.0
JUPITER_MAX_REQUESTS_PER_SECOND=5.0
BIRDEYE_MAX_REQUESTS_PER_SECOND=1.0
MORALIS_MAX_REQUESTS_PER_SECOND=10.0
PRICE_SOURCE_PRIORITY=MoralisFirst
RATE_LIMITING_ENABLED=true

# Wallet Monitoring
WALLET_LOW_BALANCE_ALERT_SOL=0.5
WALLET_MONITOR_INTERVAL_SECS=60
WALLET_RESERVE_FOR_FEES_SOL=0.1

# Position Management
MAX_CONCURRENT_TRADES=3
MAX_OPEN_POSITIONS=10
TOTAL_EXPOSURE_LIMIT_SOL=10.0

# Dip Strategy - Basic
DIP_STRATEGY_ENABLED=true
DIP_ENTRY_PCT=30.0
MIN_VOLUME_USD_5M=1000.0
WATCHLIST_TIMEOUT_SECONDS=300

# Dip Strategy - Entry Validation
VOLUME_TREND_ENABLED=true
VOLUME_SAMPLES_REQUIRED=3
VOLUME_SAMPLE_INTERVAL_SECS=5
HOLDER_STABILITY_ENABLED=true
MIN_HOLDER_RETENTION_PCT=90.0

# Trailing Stop Loss
TRAILING_STOP_ENABLED=true
TRAILING_STOP_DISTANCE_PCT=15.0

# Partial Exits
PARTIAL_EXIT_ENABLED=true
PARTIAL_EXIT_TARGET_PCT=30.0
PARTIAL_EXIT_AMOUNT_PCT=50.0

# Dynamic Timeout
DYNAMIC_TIMEOUT_ENABLED=true
TIMEOUT_EXTENSION_SECONDS=60
MAX_TIMEOUT_EXTENSIONS=2
