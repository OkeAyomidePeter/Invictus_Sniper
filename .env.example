# =============================================================================
# INVICTUS SNIPER BOT - CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# These settings are configured for SAFE TESTING with ~$2 worth of SOL
# =============================================================================

# =============================================================================
# REQUIRED - API KEYS & CREDENTIALS
# =============================================================================

# Helius API Key (get from https://helius.xyz)
HELIUS_API_KEY=your_helius_api_key_here

# Solana Private Key (base58 encoded or path to JSON file)
# WARNING: Keep this secure! Never share or commit to git!
SOLANA_PRIVATE_KEY=your_wallet_private_key_base58

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram Chat ID (your personal chat ID for alerts)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =============================================================================
# OPTIONAL - RPC & DATABASE
# =============================================================================

# Solana RPC URL (Helius mainnet recommended for speed)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Database location
DATABASE_URL=sqlite://invictus.db

# =============================================================================
# TRADING PARAMETERS - SAFE $2 TESTING
# =============================================================================

# Maximum SOL per trade (0.01 SOL ≈ $0.50 at $50/SOL)
MAX_TRADE_SIZE_SOL=0.01

# Minimum liquidity to consider a token (filters out low liquidity rugs)
MIN_LIQUIDITY_SOL=5.0

# Minimum holders to consider (filters pump.fun bots)
MIN_HOLDERS=10

# Maximum daily exposure (total SOL locked across all trades)
MAX_DAILY_EXPOSURE_SOL=0.5

# Maximum creator ownership (reject if creator holds too much)
MAX_CREATOR_OWNERSHIP_PERCENTAGE=50.0

# Enable honeypot detection
HONEYPOT_CHECK_ENABLED=true

# =============================================================================
# RISK MANAGEMENT
# =============================================================================

# Maximum positions open at once (limits exposure)
MAX_OPEN_POSITIONS=2

# Maximum concurrent buy transactions
MAX_CONCURRENT_TRADES=2

# Total exposure limit in SOL (emergency brake)
TOTAL_EXPOSURE_LIMIT_SOL=0.5

# Wallet low balance alert threshold
WALLET_LOW_BALANCE_ALERT_SOL=0.1

# Reserve SOL for transaction fees (don't trade this)
WALLET_RESERVE_FOR_FEES_SOL=0.02

# Wallet balance check interval (seconds)
WALLET_MONITOR_INTERVAL_SECS=60

# =============================================================================
# AUTO-SELL CONFIGURATION
# =============================================================================

# Enable automatic selling
AUTO_SELL_ENABLED=true

# Take profit at +50% gain
AUTO_SELL_PROFIT_TARGET_PCT=50.0

# Stop loss at -20% loss
AUTO_SELL_STOP_LOSS_PCT=20.0

# Force sell after 2 minutes (120 seconds) if no target hit
AUTO_SELL_TIMEOUT_SECONDS=120

# Slippage tolerance for sells (300 bps = 3%)
AUTO_SELL_SLIPPAGE_BPS=300

# Price check frequency (milliseconds)
AUTO_SELL_PRICE_CHECK_INTERVAL_MS=2000

# =============================================================================
# TRAILING STOP LOSS
# =============================================================================

# Enable trailing stop (lock in profits as price rises)
TRAILING_STOP_ENABLED=true

# Distance from peak before trailing stop triggers (15%)
TRAILING_STOP_DISTANCE_PCT=15.0

# =============================================================================
# PARTIAL EXITS
# =============================================================================

# Enable partial profit taking
PARTIAL_EXIT_ENABLED=true

# Take partial profit at +30% gain
PARTIAL_EXIT_TARGET_PCT=30.0

# Sell 50% of position at partial target
PARTIAL_EXIT_AMOUNT_PCT=50.0

# =============================================================================
# DYNAMIC TIMEOUT
# =============================================================================

# Allow timeout extension if position is profitable
DYNAMIC_TIMEOUT_ENABLED=true

# Add 60 seconds per extension
TIMEOUT_EXTENSION_SECONDS=60

# Maximum number of extensions allowed
MAX_TIMEOUT_EXTENSIONS=2

# =============================================================================
# JITO MEV PROTECTION
# =============================================================================

# Base tip for Jito bundles (1,000,000 lamports = 0.001 SOL)
JITO_BASE_TIP_LAMPORTS=500000

# Minimum tip (0.0005 SOL)
JITO_MIN_TIP_LAMPORTS=300000

# Maximum tip (0.002 SOL)
JITO_MAX_TIP_LAMPORTS=2000000

# Enable dynamic tip adjustment based on priority
JITO_DYNAMIC_TIPS_ENABLED=true

# =============================================================================
# DIP STRATEGY (WATCHLIST MODE)
# =============================================================================

# Enable dip buying strategy (watch tokens, buy on dip)
DIP_STRATEGY_ENABLED=false

# Entry point: buy when token drops by this % from discovery price
DIP_ENTRY_PCT=30.0

# Minimum 5-minute volume to trigger buy (USD)
MIN_VOLUME_USD_5M=500.0

# How long to watch a token before removing from list (seconds)
WATCHLIST_TIMEOUT_SECONDS=300

# Require increasing volume trend before buying
VOLUME_TREND_ENABLED=true

# Number of volume samples needed
VOLUME_SAMPLES_REQUIRED=3

# Time between volume samples (seconds)
VOLUME_SAMPLE_INTERVAL_SECS=5

# Check holder stability before buying
HOLDER_STABILITY_ENABLED=true

# Minimum holder retention (reject if >10% holders leave)
MIN_HOLDER_RETENTION_PCT=90.0

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable rate limiting to avoid API bans
RATE_LIMITING_ENABLED=true

# Helius requests per second
HELIUS_MAX_REQUESTS_PER_SECOND=10.0

# Jupiter requests per second
JUPITER_MAX_REQUESTS_PER_SECOND=5.0

# Jupiter API timeout (milliseconds)
JUPITER_API_TIMEOUT_MS=5000

# =============================================================================
# TRANSACTION RETRY
# =============================================================================

# Maximum retry attempts for failed transactions
TX_RETRY_MAX_ATTEMPTS=3

# Initial delay before retry (milliseconds)
TX_RETRY_INITIAL_DELAY_MS=500

# Maximum delay between retries (milliseconds)
TX_RETRY_MAX_DELAY_MS=5000

# Backoff multiplier (each retry waits 2x longer)
TX_RETRY_BACKOFF_MULTIPLIER=2.0
